generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth ──────────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       DjProfile?
  events        Event[]
  templates     Template[]
  notifications Notification[]

  @@map("users")
}

// ── DJ Branding (white-label) ─────────────────────────────────────
model DjProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  brandName    String?
  logoUrl      String?
  primaryColor String  @default("#C8F135")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dj_profiles")
}

// ── Event Templates ───────────────────────────────────────────────
model Template {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections TemplateSection[]

  @@map("templates")
}

model TemplateSection {
  id         String @id @default(cuid())
  templateId String
  name       String
  order      Int

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_sections")
}

// ── Events ────────────────────────────────────────────────────────
model Event {
  id           String      @id @default(cuid())
  userId       String
  clientName   String
  clientEmail  String?
  name         String
  eventDate    DateTime?
  deadline     DateTime?
  status       EventStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections  Section[]
  notifications Notification[]

  @@map("events")
}

enum EventStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

// ── Sections & Songs ──────────────────────────────────────────────
model Section {
  id      String @id @default(cuid())
  eventId String
  name    String
  order   Int

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  songs SongEntry[]

  @@map("sections")
}

model SongEntry {
  id         String     @id @default(cuid())
  sectionId  String
  title      String
  artist     String
  coverUrl   String?
  spotifyUrl String?
  youtubeUrl String?
  source     SongSource
  order      Int
  djNote     String?
  createdAt  DateTime   @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("song_entries")
}

enum SongSource {
  SPOTIFY
  YOUTUBE
}

// ── Notifications ─────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  eventId   String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
